# MySQL relational database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=scoutiq
MYSQL_USER=scoutiq_app
MYSQL_PASSWORD=replace_with_mysql_password

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# JWT signing secret. Generate a value with: openssl rand -base64 32
AUTH_SECRET=replace_with_random_secret

# Administrator created by npm run db:seed-admin
SEED_ADMIN_NAME=ScoutIQ Admin
SEED_ADMIN_EMAIL=admin@scoutiq.local
SEED_ADMIN_PASSWORD=replace_with_strong_admin_password
