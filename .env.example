# MySQL relational database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=scoutiq
MYSQL_USER=scoutiq_migrate
MYSQL_PASSWORD=replace_with_mysql_password

# Setup and migration account. Never used by HTTP request handlers.
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=replace_with_local_mysql_admin_password

# Runtime database accounts and MySQL roles created by db:provision.
MYSQL_ADMIN_USER=scoutiq_admin
MYSQL_ADMIN_PASSWORD=replace_with_runtime_admin_password
MYSQL_SCOUT_USER=scoutiq_scout
MYSQL_SCOUT_PASSWORD=replace_with_runtime_scout_password
MYSQL_AUTH_USER=scoutiq_auth
MYSQL_AUTH_PASSWORD=replace_with_runtime_auth_password

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# JWT signing secret. Generate a value with: openssl rand -base64 32
AUTH_SECRET=replace_with_random_secret

# Administrator created by npm run db:seed-admin
SEED_ADMIN_NAME=ScoutIQ Admin
SEED_ADMIN_EMAIL=admin@scoutiq.local
SEED_ADMIN_PASSWORD=replace_with_strong_admin_password
SEED_SCOUT_PASSWORD=replace_with_strong_demo_scout_password
