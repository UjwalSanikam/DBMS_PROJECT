digraph er { graph [rankdir=LR, bgcolor="white", nodesep=0.35, ranksep=0.8, splines=polyline, pad=0.3];node [shape=record,fontname="Arial",fontsize=12,style="filled",fillcolor="#eef4f8",color="#607b8b"];edge [fontname="Arial",fontsize=10,color="#597485",arrowsize=0.6];league [label="{LEAGUE|league_id PK\lleague_name UK\lcountry UK\l}"];club [label="{CLUB|club_id PK\lleague_id FK\lclub_name\l}"];player [label="{PLAYER|player_id PK\lfirst_name last_name\ldate_of_birth position\l}"];user [label="{USER|user_id PK\lemail UK\lpassword_hash role\l}"];player_club [label="{PLAYER_CLUB|player_club_id PK\lplayer_id FK\lclub_id FK\lstart_date end_date\l}"];player_statistics [label="{PLAYER_STATISTICS|stat_id PK\lplayer_id FK\lclub_id FK league_id FK\lseason UK with FKs\l}"];injury [label="{INJURY|injury_id PK\lplayer_id FK\linjury_date status\l}"];contract [label="{CONTRACT|contract_id PK\lplayer_id FK club_id FK\lstart_date end_date\l}"];transfer [label="{TRANSFER|transfer_id PK\lplayer_id FK\lfrom_club_id FK nullable\lto_club_id FK nullable\l}"];market_value_history [label="{MARKET_VALUE_HISTORY|valuation_id PK\lplayer_id FK\lvaluation_date UK with player\l}"];scout_report [label="{SCOUT_REPORT|report_id PK\lplayer_id FK\lscout_user_id FK\loverall_rating\l}"];shortlist [label="{SHORTLIST|shortlist_id PK\lplayer_id FK\lscout_user_id FK\lUK scout and player\l}"];league -> club [label="1",headlabel="0..N",labeldistance=1.8];league -> player_statistics [label="1",headlabel="0..N",labeldistance=1.8];club -> player_club [label="1",headlabel="0..N",labeldistance=1.8];player -> player_club [label="1",headlabel="0..N",labeldistance=1.8];club -> player_statistics [label="1",headlabel="0..N",labeldistance=1.8];player -> player_statistics [label="1",headlabel="0..N",labeldistance=1.8];player -> injury [label="1",headlabel="0..N",labeldistance=1.8];club -> contract [label="1",headlabel="0..N",labeldistance=1.8];player -> contract [label="1",headlabel="0..N",labeldistance=1.8];player -> transfer [label="1",headlabel="0..N",labeldistance=1.8];club -> transfer [label="0..1",headlabel="0..N",labeldistance=1.8];player -> market_value_history [label="1",headlabel="0..N",labeldistance=1.8];user -> scout_report [label="1",headlabel="0..N",labeldistance=1.8];player -> scout_report [label="1",headlabel="0..N",labeldistance=1.8];user -> shortlist [label="1",headlabel="0..N",labeldistance=1.8];player -> shortlist [label="1",headlabel="0..N",labeldistance=1.8];}